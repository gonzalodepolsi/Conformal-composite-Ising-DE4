 FontFamily->"Gill Sans MT",
 FontSize->18,
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.5, 0, 0.5]],

Cell[BoxData[
 RowBox[{"0", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[CurlyPhi]"]}], "-", "d"}], ")"}], " ", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["U", "0"], "\[Prime]",
      MultilineFunction->None], "[", "\[Rho]", "]"}]}], "+", 
   RowBox[{"2", " ", 
