         RowBox[{"K", "[", "x", "]"}]}], ")"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["Y", "e"], "[", "\[Rho]", "]"}], "\[CurlyPhi]", " ", 
