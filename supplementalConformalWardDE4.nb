    RowBox[{
     SuperscriptBox[
      SubscriptBox["U", "0"], "\[Prime]\[Prime]",
      MultilineFunction->None], "[", "\[Rho]", "]"}]}]}], "+", 
  RowBox[{
   SubscriptBox["\[Integral]", "q"], 
   RowBox[{"(", 
    RowBox[{
     OverscriptBox["R", "."], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], " ", 
       SuperscriptBox[
        RowBox[{"G", "[", 
         SuperscriptBox["q", "2"], "]"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["q", "4"], " ", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["W", 
             RowBox[{"a", ",", "0"}]], "\[Prime]",
            MultilineFunction->None], "[", "\[Rho]", "]"}]}], "+", 
         RowBox[{
          SuperscriptBox["q", "2"], " ", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["Z", "0"], "\[Prime]",
            MultilineFunction->None], "[", "\[Rho]", "]"}]}], "+", 
         RowBox[{"3", " ", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["U", "0"], "\[Prime]\[Prime]",
            MultilineFunction->None], "[", "\[Rho]", "]"}]}], "+", 
         RowBox[{"2", " ", "\[Rho]", " ", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["U", "0"], 
            TagBox[
             RowBox[{"(", "3", ")"}],
             Derivative],
            MultilineFunction->None], "[", "\[Rho]", "]"}]}]}], ")"}]}], 
      ")"}]}], ")"}]}]}]], "Equation",
 Evaluatable->False,
 ShowAutoStyles->False,
 TextAlignment->Center,
 TextJustification->1.,
 FontFamily->"Times New Roman",
 FontSize->13,
 FontWeight->"Plain",
 CellTags->"flow-U0-prime"]
}, Closed]],

