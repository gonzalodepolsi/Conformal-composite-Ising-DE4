    RowBox[{
     RowBox[{
      SubscriptBox["Y", "c"], "[", "\[Rho]", "]"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}]}], 
      ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
       RowBox[{"K", "[", "x", "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["Y", "d"], "[", "\[Rho]", "]"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], ")"}], 
