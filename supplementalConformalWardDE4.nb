Cell[CellGroupData[{

Cell["Propagator", "Subsection",
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->18,
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.5, 0, 0.5]],

Cell["At a uniform field and K = 0, the regulated propagator is", "Text",
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->14],

Cell[BoxData[
 RowBox[{
  RowBox[{"G", "[", 
   SuperscriptBox["q", "2"], "]"}], "=", 
  FractionBox["1", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["U", "0"], "\[Prime]",
      MultilineFunction->None], "[", "\[Rho]", "]"}], "+", 
    RowBox[{"2", " ", "\[Rho]", " ", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["U", "0"], "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "\[Rho]", "]"}]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["Z", "0"], "[", "\[Rho]", "]"}], " ", 
     SuperscriptBox["q", "2"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["W", 
       RowBox[{"a", ",", "0"}]], "[", "\[Rho]", "]"}], " ", 
     SuperscriptBox["q", "4"]}], "+", 
    RowBox[{"R", "[", 
     SuperscriptBox["q", "2"], "]"}]}]]}]], "Equation",
 Evaluatable->False,
 ShowAutoStyles->False,
 TextAlignment->Center,
 TextJustification->1.,
 FontFamily->"Times New Roman",
 FontSize->13,
 FontWeight->"Plain"],

Cell[TextData[{
 "Primes on U, Z, W and Y denote derivatives with respect to \[Rho]. Primes \
on G denote derivatives with respect to its argument ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "2"], TraditionalForm]]],
 ". The field argument of G and its scale dependence are suppressed."
}], "Text",
 CellChangeTimes->{{4.002057518421566*^9, 4.0020575268703976`*^9}},
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->14],

Cell[BoxData[
 RowBox[{"\[Rho]", "=", 
  FractionBox[
   SuperscriptBox["\[CurlyPhi]", "2"], "2"], ",", " ", 
  SubscriptBox["D", "\[CurlyPhi]"], "=", 
  FractionBox[
   RowBox[{"d", "-", "2", "+", "\[Eta]"}], "2"]}]], "Equation",
 Evaluatable->False,
 ShowAutoStyles->False,
 TextAlignment->Center,
 TextJustification->1.,
 FontFamily->"Times New Roman",
 FontSize->13,
 FontWeight->"Plain"],

Cell[TextData[{
 "All momenta and functions in the fixed-point and Ward identities are \
dimensionless; tildes are suppressed. With the dimensionless profile R(y), it \
is ",
 Cell[BoxData[
  OverscriptBox["R", "."]],
  Evaluatable->False,
  ShowAutoStyles->False,
  TextJustification->1.,
  FontFamily->"Times New Roman",
  FontSize->13,
  FontWeight->"Plain"],
 "=(2-\[Eta])R(y)-2yR'(y), where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    SuperscriptBox["q", "2"]}], TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{{4.0020576025686607`*^9, 4.0020576722912436`*^9}},
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->14],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[Integral]", "q"], "=", 
  RowBox[{"\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "d"], " ", "q"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}], "d"]]}]}]], "Equation",
 Evaluatable->False,
 ShowAutoStyles->False,
 TextAlignment->Center,
 TextJustification->1.,
 FontFamily->"Times New Roman",
 FontSize->13,
 FontWeight->"Plain"],

Cell["\<\
The loop expressions have already been averaged over momentum directions, \
with the angular average normalized so that the average of 1 is 1. The \
remaining integration uses the rotationally invariant measure above.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->14]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fixed point equations", "Chapter",
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->20,
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.5, 0, 0.5]],

Cell["\<\
The dimensional contributions below follow from the rescaling in Eqs. (2)-(4) \
of the article. The momentum integrands are the DE4 projections, including \
their factor of the scale derivative of R. The potential equations are \
written for U0' and U1'. D_O is the scaling dimension of the composite \
operator; set d = 3 for the application studied in the article.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->14],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   SubscriptBox["U", "0"], "\[Prime]",
   MultilineFunction->None], "[", "\[Rho]", "]"}]]]], "Subsection",
