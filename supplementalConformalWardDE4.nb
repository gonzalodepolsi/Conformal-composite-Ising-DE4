Cell[TextData[{
 "Remark: all coefficient functions are even under the Ising symmetry and are \
expressed as functions of \[Rho] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CurlyPhi]", "2"], "/", "2"}], TraditionalForm]]],
 ". Primes on these functions mean rho derivatives. Scale labels and \
dimensionless tildes are suppressed."
}], "Subtitle",
 CellChangeTimes->{{4.0020574186053915`*^9, 4.0020574412723455`*^9}},
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->18,
 FontColor->GrayLevel[0.35]],

Cell[CellGroupData[{

Cell["Ansatz", "Chapter",
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->20,
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.5, 0, 0.5]],

Cell["\<\
We use the derivative expansion through fourth order, retaining terms linear \
in the source K, with the operator basis of Eq. (9) of the article. All \
coefficient functions below are functions of \[Rho].\
\>", "Text",
 CellChangeTimes->{{4.002057564132315*^9, 4.002057564464957*^9}},
 TextAlignment->Center,
 FontFamily->"Gill Sans MT",
 FontSize->14],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[CapitalGamma]", "k"], "[", "\[CurlyPhi]", ",", "K", "]"}], 
  "=", 
  SubscriptBox["\[Integral]", "x"], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     SubscriptBox["U", "0"], "[", "\[Rho]", "]"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["Z", "0"], "[", "\[Rho]", "]"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
      "2"]}], "+", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SubscriptBox["W", 
          RowBox[{"a", ",", "0"}]], "[", "\[Rho]", "]"}], "2"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], 
          ")"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], 
          ")"}]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubscriptBox["W", 
          RowBox[{"b", ",", "0"}]], "[", "\[Rho]", "]"}], "2"], "\[CurlyPhi]",
        " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], ")"}], 
       " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], 
          ")"}]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubscriptBox["W", 
          RowBox[{"c", ",", "0"}]], "[", "\[Rho]", "]"}], "2"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], 
        ")"}]}]}], ")"}], "+", 
    RowBox[{
     RowBox[{"K", "[", "x", "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["U", "1"], "[", "\[Rho]", "]"}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{
          SubscriptBox["Z", "1"], "[", "\[Rho]", "]"}], "2"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
         "2"]}], "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            SubscriptBox["W", 
             RowBox[{"a", ",", "1"}]], "[", "\[Rho]", "]"}], "2"], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], 
             ")"}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], 
             ")"}]}], ")"}]}], "+", 
         RowBox[{
          FractionBox[
           RowBox[{
            SubscriptBox["W", 
             RowBox[{"b", ",", "1"}]], "[", "\[Rho]", "]"}], "2"], 
          "\[CurlyPhi]", " ", 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], ")"}],
           " ", 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], 
             ")"}]}], ")"}]}], "+", 
         RowBox[{
          FractionBox[
           RowBox[{
            SubscriptBox["W", 
             RowBox[{"c", ",", "1"}]], "[", "\[Rho]", "]"}], "2"], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Nu]"], " ", "\[CurlyPhi]"}], 
           ")"}]}]}], ")"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["Y", "a"], "[", "\[Rho]", "]"}], "\[CurlyPhi]", " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], " ", "\[CurlyPhi]"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
       RowBox[{"K", "[", "x", "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["Y", "b"], "[", "\[Rho]", "]"}], "\[CurlyPhi]", " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
